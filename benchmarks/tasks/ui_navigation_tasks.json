                    "action": "select",
                    "box": [0.18, 0.14, 0.34, 0.19]
                },
                {
                    "id": "btn_pin_filter_view",
                    "label": "Pin Filter View Button",
                    "role": "button",
                    "description": "Click Pin Filter View as active tab",
                    "action": "click",
                    "box": [0.36, 0.14, 0.44, 0.19]
                }
            ],
            "transitions": {
                "btn_dismiss_sync_modal": {
                    "modal_dismissed": true
                },
                "select_high_value_leads_filter": {
