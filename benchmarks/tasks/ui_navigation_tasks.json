    {
        "id": "UI-04",
        "complexity": "High",
        "category": "artcraft_multilayer_compositing",
        "goal": "1. Remove background from the foreground character layer -> 2. Composite the 3D studio backdrop layer -> 3. Scrub the timeline playhead to keyframe 24 -> 4. Render the final composited shot. Save the trajectory to 'artcraft_compositing_result.json'.",
        "tool_chain": [
            "ui_navigate",
            "write_file"
        ],
        "recommended_skills": [],
