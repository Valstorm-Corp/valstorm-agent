            "content_regex": "\"btn_dismiss_sync_modal\"[\\s\\S]*\"select_high_value_leads_filter\"[\\s\\S]*\"btn_pin_filter_view\"",
            "cleanup": [
                "ui_blocker_result.json"
            ]
        }
